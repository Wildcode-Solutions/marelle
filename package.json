{
  "name": "marelle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "mkdir -p dist && wrangler dev --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply marelle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply marelle-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "mobile:sync": "npm run build && cap sync",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "ios:add": "cap add ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "emoji-picker-element": "^1.29.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.124.0"
  }
}
